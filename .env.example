# Bu faylni .env nomi bilan nusxalang va o'zingizning qiymatlaringizni kiriting.
# .env fayli HECH QACHON GitHub'ga yuklanmasligi kerak (.gitignore'da bor).

# Server porti
PORT=3000

# Tasodifiy, uzun va maxfiy satr. Masalan terminalda ishlab chiqarish uchun:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Administrator paroli oddiy matnda EMAS, balki uning bcrypt xeshi shu yerda turadi.
# Xeshni olish uchun avval .env ni to'ldirmasdan quyidagini ishga tushiring:
#   npm run hash-password -- "sizning-parolingiz"
# Chiqqan xesh qiymatini shu yerga qo'ying.
ADMIN_PASSWORD_HASH=

# Talaba va admin sessiya tokenlarining amal qilish muddati
STUDENT_TOKEN_TTL=2h
ADMIN_TOKEN_TTL=4h

# Agar frontend boshqa domenda joylashgan bo'lsa, shu yerga uning manzilini yozing
# (masalan https://mening-saytim.uz). Bo'sh qoldirsangiz, faqat shu server o'z ichida
# joylashgan public/ papkasidan so'rov qabul qiladi.
ALLOWED_ORIGIN=
